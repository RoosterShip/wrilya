                {
                    "type": "Text",
                    "id": "d1f1726c-c405-4ff9-a3b4-cff680229745",
                    "label": "text",
                    "x": 25,
                    "y": 610,
                    "text": "Today colonization began on the newly discovered world of Tinope.\n\nRecently discovered deposits of Apatite will allow for high crop yields of much needed soy foods in the region.\n\nAs quoted from the newly appointed magistrate \"We are aiming for 100 tons of sellable crops by the end of next year. ",
                    "fontFamily": "system-ui",
                    "fontSize": "24px",
                    "wordWrapWidth": 600
                },
                {
                    "type": "Image",
                    "id": "cf4fe810-7558-4251-a21a-39955ac72248",
