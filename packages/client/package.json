    "homepage": "https://www.wrilya.com",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "wait-port localhost:3001 && wait-port localhost:4000 && wait-port localhost:8545 && vite --config vite/config.dev.mjs",
        "start": "vite --config vite/config.dev.mjs",
        "build.prod": "vite build --config vite/config.prod.mjs && phaser-asset-pack-hashing -j -r dist",
        "build.test": "vite build --config vite/config.test.mjs && phaser-asset-pack-hashing -j -r dist"
    },
    "devDependencies": {
        "phaser-asset-pack-hashing": "^1.0.6",
        "terser": "^5.31.1",
        "typescript": "^5.5.4",
        "vite": "^5.3.4",
        "wait-port": "^1.1.0"
    },
    "dependencies": {
        "@latticexyz/common": "2.0.12",
        "@latticexyz/dev-tools": "2.0.12",
        "@latticexyz/recs": "2.0.12",
        "@latticexyz/schema-type": "2.0.12",
        "@latticexyz/store-sync": "2.0.12",
        "@latticexyz/utils": "2.0.12",
        "@latticexyz/world": "2.0.12",
        "@phaserjs/editor-scripts-core": "^2.0.0",
        "@phaserjs/editor-scripts-simple-animations": "^2.0.0",
        "axios": "^1.7.2",
        "contracts": "workspace:*",
        "ethers": "^6.13.1",
        "phaser": "3.80.1",
        "phaser3-rex-plugins": "^1.80.5",
        "viem": "2.18.0",
        "rxjs": "7.8.1"
    }
